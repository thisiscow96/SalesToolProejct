# 이 파일을 복사해 server/.env 로 저장한 뒤 값을 채운다. server/.env 는 Git에 커밋하지 않는다.
# 무료 스택 전환 안내: docs/99. 배포관리/배포/무료-스택-전환.md

# ── DB (Neon 무료 권장 — Postgres 그대로, 만료 없음) ──
# Neon 콘솔 → Connect → 연결 문자열 (끝에 ?sslmode=require 포함)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE_NAME?sslmode=require
# DB_SSL=true            # SSL 강제 (URL에 sslmode가 없을 때)
# DB_POOL_MAX=5          # 무료 DB 연결 수 한도에 맞춤
# DB_CONNECT_TIMEOUT_MS=15000

# ── 인증 메일 (앞에서부터 시도, 실패·한도 초과 시 다음으로) ──
# EMAIL_PROVIDERS=resend,brevo,smtp
# RESEND_API_KEY=        # 무료 일 100통
# RESEND_FROM=판매툴 <noreply@your-domain>
# BREVO_API_KEY=         # 무료 일 300통
# BREVO_FROM=noreply@your-domain
# BREVO_FROM_NAME=판매툴
# SMTP_HOST=smtp.gmail.com   # 로컬·VPS 전용 (Render 등 PaaS는 SMTP 포트 차단)
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=             # Gmail 앱 비밀번호
# EXPOSE_DEV_CODE=false  # 운영에서는 false(기본). true면 메일 실패 시 인증번호를 응답에 노출

# ── 로그인 토큰 (T-101, 필수) ──
# 로그인하면 서버가 이 비밀로 서명한 토큰(JWT, HS256)을 주고, 모든 보호 API는 Authorization: Bearer <토큰> 만 믿는다.
# 32자 이상 임의 문자열. 만들기: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# 운영(NODE_ENV=production)에서 비어 있거나 32자 미만이면 서버가 시작하지 않는다. 개발에서는 경고 후 임시 비밀(재시작 시 로그인 풀림).
# 값을 바꾸면 이미 로그인한 사용자는 모두 다시 로그인해야 한다.
AUTH_SECRET=
# AUTH_TOKEN_TTL_HOURS=12   # 토큰 유효 시간(시간). 지나면 401 → 로그인 화면

# ── 프론트가 API를 직접 부를 때만 (Cloudflare Pages 프록시를 쓰면 불필요) ──
# ALLOWED_ORIGINS=https://salestool.pages.dev,https://garaksalestool.com

# ── T-203 가락 경락 수집 + 매입서 대조(이름만 — 값은 배포 환경에만) ──
# data.go.kr "디코딩 키"를 넣는다(서버가 URLSearchParams 로 한 번만 인코딩). 키가 없으면 목업(lib/auction/mock)으로 돌고 화면에 "목업 데이터" 배지
# AT_AUCTION_API_KEY=        # aT 실시간 경매정보(15141808)·정산정보(15141809)·표준코드(15141818)
# GARAK_API_KEY=             # 가락시장 주요품목 가격(15004517, 참고 시세)
# COLLECT_TRIGGER_TOKEN=     # 외부 cron(.github/workflows/collect-tick.yml)이 X-Collect-Token 으로 보냄. 16자 이상, 없으면 tick 라우트 404
# AUCTION_SOURCE_MODE=       # mock 이면 키가 있어도 목업(테스트·로컬)
# AUCTION_MOCK_SCENARIO=     # 목업 시나리오 normal|paged|empty|auth|quota|rate429|5xx|timeout|revised|bad (기본 normal)
# COLLECT_TIMER_ENABLED=     # true 면 서버 안 타이머(5분)도 tick (상시 실행 호스트용)
# AUCTION_HTTP_TIMEOUT_MS=   # 외부 호출 타임아웃(기본 10000)
# AUCTION_MARKET_CODE=       # 도매시장 코드(기본 110001 서울가락 [가정 — 표준코드로 확인])
# AUCTION_CORP_CODES=        # 수집 대상 법인 한정(쉼표 구분, 예 11000105 = 한국청과㈜). 비우면 전체 법인. 값이 있으면 실시간 경락 호출에 cond[corp_cd::EQ] 를 붙여 법인마다 따로 부름
#                            #   (호출 수 = 법인 수 × AUCTION_ITEM_COMBOS 조합 수 × 쪽 수). 스냅샷 corp_scope 에 범위를 남겨, 법인 한정 수집을 "그날 전체 완료"로 보지 않음.
#                            #   철회 판정·정산 대조도 그 법인만. 이미 저장된 다른 법인 행은 지우지 않음. 현재 값은 관리자만 수집 현황 API(corp_scope)로 봄. 바꾸면 서버 재시작
# ALLOW_MOCK_CONVERT=        # 테스트 DB 에서만 true — 목업 경락으로 자동 매입전환 허용(운영 금지)
# AUCTION_MOCK_CONTROL=      # 테스트 DB 에서만 true — 작업 params.mock_scenario 로 장애 주입(운영 금지)
# AUCTION_TRADE_KEEP_DAYS=   # 경락 보관 일수. 비우면 무기한(로컬 영구 DB). 운영(무료 DB 1GB)은 예: 90 — PURGE_RAW 가 거래일이 오늘-N일 이전인 경락·이력·참고 시세·빈 스냅샷을 분할 삭제.
#                            #   매입서 대조 근거(줄 최적 후보·후보·매입전환·대조 이력)가 가리키는 경락은 남김. 최소 COLLECT_BACKFILL_DAYS+1(기본 8), 원천 로그 보관도 이 일수를 넘지 않음
# PURGE_BUDGET_MS=           # 정리 작업 한 번의 시간 예산(기본 20000). 넘으면 멈추고 다음 정리에서 이어서
# PURGE_BATCH_ROWS=          # 경락 정리 한 번에 지우는 행 수(기본 1000)
# RAW_KEEP_OK_DAYS= / RAW_KEEP_ERROR_DAYS=  # 원천 응답 로그 보관(기본 정상 90 · 오류 30일)
# DB_STORAGE_LIMIT_MB=       # 관리자 "DB 사용량" 한도(기본 1024 = 무료 DB 1GB, 0 = 한도 없음). 80% 넘으면 경고
