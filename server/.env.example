# 이 파일을 복사해 server/.env 로 저장한 뒤 값을 채운다. server/.env 는 Git에 커밋하지 않는다.
# 무료 스택 전환 안내: docs/99. 배포관리/배포/무료-스택-전환.md

# ── DB (Neon 무료 권장 — Postgres 그대로, 만료 없음) ──
# Neon 콘솔 → Connect → 연결 문자열 (끝에 ?sslmode=require 포함)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE_NAME?sslmode=require
# DB_SSL=true            # SSL 강제 (URL에 sslmode가 없을 때)
# DB_POOL_MAX=5          # 무료 DB 연결 수 한도에 맞춤
# DB_CONNECT_TIMEOUT_MS=15000

# ── 인증 메일 (앞에서부터 시도, 실패·한도 초과 시 다음으로) ──
# EMAIL_PROVIDERS=resend,brevo,smtp
# RESEND_API_KEY=        # 무료 일 100통
# RESEND_FROM=판매툴 <noreply@your-domain>
# BREVO_API_KEY=         # 무료 일 300통
# BREVO_FROM=noreply@your-domain
# BREVO_FROM_NAME=판매툴
# SMTP_HOST=smtp.gmail.com   # 로컬·VPS 전용 (Render 등 PaaS는 SMTP 포트 차단)
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=             # Gmail 앱 비밀번호
# EXPOSE_DEV_CODE=false  # 운영에서는 false(기본). true면 메일 실패 시 인증번호를 응답에 노출

# ── 프론트가 API를 직접 부를 때만 (Cloudflare Pages 프록시를 쓰면 불필요) ──
# ALLOWED_ORIGINS=https://salestool.pages.dev,https://garaksalestool.com
